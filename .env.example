# Copy to .env.local (git-ignored) and adjust. Never commit real values.
# Only VITE_* variables reach the browser bundle; everything else stays on your machine.

# --- App ---------------------------------------------------------------
# API base path used by the browser. Keep it same-origin: the backend's session and CSRF cookies are host-only.
VITE_API_BASE_URL=/api

# --- Dev server ----------------------------------------------------------
# Where the Vite dev server proxies /api (the FastAPI backend).
VEKRO_API_TARGET=http://127.0.0.1:8000

# Where `npm run api:sync` downloads the OpenAPI contract from.
OPENAPI_URL=http://127.0.0.1:8000/openapi.json

# --- Backend-gap mocks (dev only, see docs/BACKEND_GAPS.md) ----------------
# Set to true to serve a gap from MSW instead of the backend.
# P0-1 (#6)
VITE_MOCK_TRANSACTION_READ=false
# P0-2 (#7)
VITE_MOCK_SELLER_LISTS=false
# P0-3 (#8)
VITE_MOCK_PAYMENT_INSTRUCTION=false
# P0-5 (#139)
VITE_MOCK_LISTING_CONTENT=false
# P0-6 (#140)
VITE_MOCK_LISTING_UPDATE=false
# P0-7 (#141)
VITE_MOCK_DEADLINES=false
# P1-1 (#10)
VITE_MOCK_PUBLIC_ORDER=false
# P1-2 (#11)
VITE_MOCK_PHONE_AUTH=false
# P1-3 (#12)
VITE_MOCK_BUYER_ORDERS=false
# P1-5 (#142)
VITE_MOCK_TIMELINE=false
# P1-6 (#143)
VITE_MOCK_PAYMENT_STATUS=false
# P1-7 (#144)
VITE_MOCK_SELLER_PROFILE=false
# P1-8 (#145)
VITE_MOCK_NOTIFICATION_READ=false
# P1-9 (#146)
VITE_MOCK_ESCALATE=false
# P1-10 (#147)
VITE_MOCK_ADMIN_SEARCH=false
# P2-3 (#148)
VITE_MOCK_ANALYTICS=false
# P2-4 (#149)
VITE_MOCK_ACCOUNT_SECURITY=false
# P2-5 (#150)
VITE_MOCK_NOTIFICATION_PREFS=false

# --- Design tooling (not used by the app) ---------------------------------
# Google Stitch API key for the Stitch MCP server. Keep it in .env (git-ignored).
STITCH_API_KEY=
