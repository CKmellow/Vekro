{
  "name": "vekro-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0 && node scripts/check-boundaries.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tokens": "node scripts/tokens.mjs",
    "api:sync": "node scripts/api-sync.mjs",
    "api:types": "node scripts/api-sync.mjs --types-only"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.104.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@google/design.md": "0.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.3",
    "typescript-eslint": "8.71.2",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
