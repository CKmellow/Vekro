# Vekro web app (M17 #134). One site: the app, and the API under /api, so the session and CSRF
# cookies stay first-party and the API needs no CORS. API_UPSTREAM is set at start-up
# (for example http://api.internal:8000 or https://api.vekro.me).
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  # Security headers on every response. __CSP_HEADER__ is filled in by the build (vite.config.ts,
  # renderNginxTemplate in src/app/csp.ts) with the same policy as the <meta> tag, including the
  # anchoring RPC origin (#294). The image serves the rendered copy from .deploy/.
  add_header Content-Security-Policy "__CSP_HEADER__" always;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml application/manifest+json;

  location /api/ {
    proxy_pass ${API_UPSTREAM}/;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_ssl_server_name on;
  }

  # Content-hashed files: cache for a year.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Content-Security-Policy "__CSP_HEADER__" always;
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  # The service worker, the shell and the build id must always be fresh, or users get stuck on an old version
  # (#302). no-store, not no-cache: Cloudflare caches .js at the edge and then sends browsers its own 4-hour
  # Browser Cache TTL instead of no-cache; it neither caches nor rewrites a no-store response.
  location ~ ^/(sw\.js|workbox-.*\.js|registerSW\.js|manifest\.webmanifest|index\.html|version\.json)$ {
    add_header Cache-Control "no-store" always;
    # nginx's mime.types has no .webmanifest (#304): browsers expect application/manifest+json.
    types { application/manifest+json webmanifest; application/javascript js; text/html html; application/json json; }
    add_header Content-Security-Policy "__CSP_HEADER__" always;
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri =404;
  }

  # Client-side routes.
  location / {
    add_header Cache-Control "no-cache" always;
    add_header Content-Security-Policy "__CSP_HEADER__" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    try_files $uri /index.html;
  }
}
